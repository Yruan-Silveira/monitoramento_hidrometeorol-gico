<?xml version="1.0" encoding="utf-8"?>
<!-- Só entra na build DEBUG: um segundo ícone "Diagnóstico Hidro" para testar a camada de dados
     (Pessoa A) sem depender das telas. Não vai para o APK/AAB de release. -->
