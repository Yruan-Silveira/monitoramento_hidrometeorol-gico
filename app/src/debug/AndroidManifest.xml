    <application>
        <activity
            android:name=".debug.DiagnosticoActivity"
            android:exported="true"
            android:label="Diagnóstico Hidro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
